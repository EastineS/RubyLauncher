diff --git a/io/redspace/ironsspellbooks/doormancy/client/DoorRipples.java b/io/redspace/ironsspellbooks/doormancy/client/DoorRipples.java
new file mode 100644
index 0000000..9744577
--- /dev/null
+++ b/io/redspace/ironsspellbooks/doormancy/client/DoorRipples.java
@@ -0,0 +1,93 @@
+package io.redspace.ironsspellbooks.doormancy.client;
+
+import com.mojang.blaze3d.vertex.VertexConsumer;
+import io.redspace.ironsspellbooks.doormancy.entity.DoorEntity;
+import java.util.ArrayList;
+import java.util.HashMap;
+import java.util.Iterator;
+import java.util.List;
+import java.util.Map;
+import net.minecraft.client.Minecraft;
+import net.minecraft.client.renderer.MultiBufferSource;
+import net.minecraft.util.Mth;
+import org.joml.Matrix4f;
+
+/** Ripples left on a doorway plane where something passed through, visible on both faces of both doors. */
+public final class DoorRipples {
+    private static final Map<Integer, List<DoorRipples.Ripple>> RIPPLES = new HashMap<>();
+    private static final float LIFE = 20.0F;
+
+    public static void add(int door, float x, float y, int color, float size) {
+        Minecraft mc = Minecraft.getInstance();
+        if (mc.level != null) {
+            long now = mc.level.getGameTime();
+            List<DoorRipples.Ripple> list = RIPPLES.computeIfAbsent(door, k -> new ArrayList<>());
+            if (list.size() >= 8) {
+                list.remove(0);
+            }
+
+            list.add(new DoorRipples.Ripple(x, y, color, size, now));
+            if (RIPPLES.size() > 48) {
+                prune(now);
+            }
+        }
+    }
+
+    private static void prune(long now) {
+        Iterator<List<DoorRipples.Ripple>> it = RIPPLES.values().iterator();
+
+        while (it.hasNext()) {
+            List<DoorRipples.Ripple> l = it.next();
+            l.removeIf(r -> (float)(now - r.start) > LIFE);
+            if (l.isEmpty()) {
+                it.remove();
+            }
+        }
+    }
+
+    static void render(DoorEntity e, Matrix4f m, MultiBufferSource buf, float pt, float glow) {
+        List<DoorRipples.Ripple> list = RIPPLES.get(e.getId());
+        Minecraft mc = Minecraft.getInstance();
+        if (list != null && mc.level != null) {
+            float now = (float)mc.level.getGameTime() + pt;
+            list.removeIf(r -> now - (float)r.start > LIFE || now < (float)r.start - 1.0F);
+            if (list.isEmpty()) {
+                RIPPLES.remove(e.getId());
+            } else {
+                float hw = e.openingHalfWidth();
+                VertexConsumer ring = buf.getBuffer(DRenderTypes.additive(DRenderTypes.SHOCKWAVE));
+                VertexConsumer core = buf.getBuffer(DRenderTypes.additive(DRenderTypes.GLOW));
+
+                for (DoorRipples.Ripple r : list) {
+                    float k = Mth.clamp((now - (float)r.start) / LIFE, 0.0F, 1.0F);
+                    float ease = 1.0F - (1.0F - k) * (1.0F - k) * (1.0F - k);
+                    float rad = (4.0F + hw * 1.1F * ease) * r.size;
+                    float a = (1.0F - k) * (1.0F - k) * 0.9F * glow;
+                    // Two rings, offset to either face, so the ripple reads from both sides of the plane.
+                    quad(ring, m, r.x, r.y, rad, -0.08F, r.color, a);
+                    quad(ring, m, r.x, r.y, rad, 0.08F, r.color, a);
+                    quad(ring, m, r.x, r.y, rad * 0.55F, -0.1F, 16777215, a * 0.5F);
+                    float ca = (1.0F - k) * 0.6F * glow;
+                    quad(core, m, r.x, r.y, (3.0F + 7.0F * (1.0F - k)) * r.size, -0.12F, r.color, ca);
+                }
+            }
+        }
+    }
+
+    private static void quad(VertexConsumer vc, Matrix4f m, float x, float y, float rad, float z, int c, float a) {
+        float rr = (float)(c >> 16 & 0xFF) / 255.0F;
+        float gg = (float)(c >> 8 & 0xFF) / 255.0F;
+        float bb = (float)(c & 0xFF) / 255.0F;
+        float aa = Mth.clamp(a, 0.0F, 1.0F);
+        vc.vertex(m, x - rad, y - rad, z).color(rr, gg, bb, aa).uv(0.0F, 1.0F).endVertex();
+        vc.vertex(m, x + rad, y - rad, z).color(rr, gg, bb, aa).uv(1.0F, 1.0F).endVertex();
+        vc.vertex(m, x + rad, y + rad, z).color(rr, gg, bb, aa).uv(1.0F, 0.0F).endVertex();
+        vc.vertex(m, x - rad, y + rad, z).color(rr, gg, bb, aa).uv(0.0F, 0.0F).endVertex();
+    }
+
+    private DoorRipples() {
+    }
+
+    private static record Ripple(float x, float y, int color, float size, long start) {
+    }
+}
